{
  "name": "@cem/builder",
  "version": "1.0.0",
  "description": "The TypeScript compiler and architectural guard for create-express-modular",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "cem",
    "create-express-modular",
    "builder"
  ],
  "author": "levi9111",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/node": "^18.16.0",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.0.0-alpha.34"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
